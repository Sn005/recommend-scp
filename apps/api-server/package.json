{
  "name": "@recommend-scp/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./src/app.ts",
      "import": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@hono/zod-validator": "^0.7.6",
    "@recommend-scp/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.4",
    "@upstash/redis": "^1.36.2",
    "hono": "^4.7.10",
    "linkedom": "^0.18.12",
    "openai": "^4.77.0",
    "pino": "^10.2.0",
    "zod": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
}
